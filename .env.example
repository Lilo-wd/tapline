# Copier en .env pour le developpement local (netlify dev).
# En production, saisir ces valeurs dans Netlify > Site settings > Environment variables.

# Cle SECRETE Stripe. Ne jamais la committer ni l exposer cote client.
STRIPE_SECRET_KEY=REMPLACER_PAR_TA_CLE_sk_test_...

# Secret de signature du webhook Stripe (whsec_...). Fourni par Stripe au
# moment de creer l'endpoint webhook (Developers > Webhooks). Sert a
# verifier qu'un evenement recu vient bien de Stripe, pas d'un tiers.
STRIPE_WEBHOOK_SECRET=REMPLACER_PAR_TON_SECRET_whsec_...

# Cle API Resend, pour l'envoi des e-mails de confirmation et d'activation.
RESEND_API_KEY=REMPLACER_PAR_TA_CLE_re_...

# Adresse d'expedition des e-mails automatiques. Le domaine doit etre
# verifie dans Resend (enregistrements DNS chez IONOS) avant de pouvoir
# envoyer depuis une adresse @tapline.fr.
FROM_EMAIL=Tapline <commandes@tapline.fr>

# Adresse publique du site (sans slash final).
# Sur Netlify, la variable URL est fournie automatiquement : SITE_URL sert de surcharge.
SITE_URL=http://localhost:8888
