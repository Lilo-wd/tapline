# Copier en .env pour le developpement local (netlify dev).
# En production, saisir ces valeurs dans Netlify > Site settings > Environment variables.

# Cle SECRETE Stripe. Ne jamais la committer ni l exposer cote client.
STRIPE_SECRET_KEY=REMPLACER_PAR_TA_CLE_sk_test_...

# Adresse publique du site (sans slash final).
# Sur Netlify, la variable URL est fournie automatiquement : SITE_URL sert de surcharge.
SITE_URL=http://localhost:8888
